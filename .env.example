# Production runtime configuration. Do not commit real values or copy these placeholders as credentials.
CLINIC_ENV=production
DJANGO_ALLOWED_HOSTS=drgerami-md.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://drgerami-md.ir
# Supply a new random 64+ character value via the hosting secret manager.
DJANGO_SECRET_KEY=
# Use a dedicated PostgreSQL database. See README before using an existing Supabase project.
DATABASE_URL=
# Provider CA bundle may be needed for your PostgreSQL endpoint.
DB_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
CLINIC_DATA_DIR=/app/.data
# Only when a trusted ingress overwrites X-Forwarded-Proto and the origin is inaccessible publicly.
TRUST_HTTPS_PROXY=1
# Optional Cloudflare Worker origin gate; same strong value in both hosting secret stores.
CLINIC_PROXY_KEY=
# Google Calendar is optional and disabled until all required values + owner consent are provided.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_REDIRECT_URI=https://drgerami-md.ir/dash/calendar/oauth/callback/
# Public account binding; actual ownership is verified by Google's signed ID token + nonce.
GOOGLE_CALENDAR_ACCOUNT=dr.gerami.md@gmail.com
# Shared site/patient account entry; root /account/ may be used when the website client is activated.
SITE_ACCOUNT_URL=/dash/account/
# Google sign-in is separate from Calendar OAuth; only OpenID/email/profile scopes.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=https://drgerami-md.ir/dash/account/google/callback/
# New owner-selected shared identity bridge. Keep 0 until the private native
# backend is mounted on the main site's /dash/ with its deployment/privacy gates.
# No third Supabase project or service-role key is required by this bridge.
SHARED_AUTH_ENABLED=0
